# Copy to .env.local for development. Never commit real values.

# development | preview | production — which kind of deployment this is.
APP_ENV=development
# preopening | open — independent of APP_ENV. Controls tense and CTAs.
LAUNCH_STAGE=preopening
# Public origin of this deployment (no trailing slash). Must be the real assigned domain in production.
SITE_URL=http://localhost:3000

# PostgreSQL connection for lead storage. Leave empty to run the site with the
# registration form in its honest "unavailable" state (no fake success).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/reshape_dev
# Set to "require" for managed databases that need TLS.
DATABASE_SSL=disable

# Secret for keyed hashes (duplicate grouping, rate-limit buckets). 32+ random characters.
LEAD_HASH_SECRET=replace-with-a-secure-development-value

# Version label of the published privacy notice. Any value starting with "draft"
# blocks lead collection when APP_ENV=production.
PRIVACY_NOTICE_VERSION=draft
# Verified privacy contact shown in the notice (email or URL). Required in production.
PRIVACY_CONTACT=

# true only when the app runs behind a proxy that sets X-Forwarded-For reliably.
TRUST_PROXY=false

# Analytics wrapper. No provider is bundled; leave false.
ANALYTICS_ENABLED=false
