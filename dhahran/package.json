{
  "name": "reshape-dhahran",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.11 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:validate": "tsx scripts/validate-content.ts",
    "scenes:build": "tsx scripts/build-scenes.ts",
    "scenes:check": "tsx scripts/build-scenes.ts --check",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "bash scripts/dev-db.sh",
    "leads": "tsx scripts/leads.ts",
    "leads:export": "tsx scripts/leads.ts export",
    "privacy:retention:dry-run": "tsx scripts/leads.ts retention",
    "privacy:retention:execute": "tsx scripts/leads.ts retention --execute --confirm-delete"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.17",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
