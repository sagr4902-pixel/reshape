# Copy to .env (git-ignored) to use the ElevenLabs SDK commands (npm run el -- ...).
# Not needed in Claude sessions that use the ElevenLabs connector.
ELEVENLABS_API_KEY=

# Optional: a Chrome/Chromium binary for rendering where Remotion cannot download its own.
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell
