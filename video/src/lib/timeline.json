 "voLines": [
  {
   "id": "hook",
   "start": 0.65,
   "end": 4.95,
   "text": "مو كل تمرين يغيّرك… بس فيه تمرين… يعيد تشكيلك."
  },
  {
   "id": "brand",
   "start": 6.15,
   "end": 11.67,
   "text": "في ريشيب، كل حصّة هي خطوة جديدة… لقوّتك، ولياقتك، وثقتك بنفسك."
  },
  {
   "id": "group",
   "start": 12.45,
   "end": 17.73,
   "text": "حصص جماعية، أجواء حماسية، وتحدّي يخلّيك تطلع أفضل من كل تمرين."
  },
  {
   "id": "motivation",
   "start": 20.35,
   "end": 23.53,
   "text": "مهما كان مستواك… هنا تبدا خطوتك للأفضل."
  },
  {
   "id": "cta",
   "start": 26.25,
   "end": 31.89,
   "text": "ريشيب… غيّر أداءك، وارفع مستواك. سجّل الحين، وخلّ التحدّي يبدا!"
  }
 ],
