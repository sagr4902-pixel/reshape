 "voLines": [
  {
   "id": "hook",
   "start": 0.6,
   "end": 4.9,
   "text": "مو كل تمرين يغيّرك… بس فيه تمرين… يعيد تشكيلك."
  },
  {
   "id": "brand",
   "start": 6.1,
   "end": 12.36,
   "text": "في RESHAPE، كل حصّة هي خطوة جديدة… لقوّتك، ولياقتك، وثقتك بنفسك."
  },
  {
   "id": "group",
   "start": 13.5,
   "end": 18.78,
   "text": "حصص جماعية، أجواء حماسية، وتحدّي يخلّيك تطلع أفضل من كل تمرين."
  },
  {
   "id": "motivation",
   "start": 20.2,
   "end": 23.38,
   "text": "مهما كان مستواك… هنا تبدا خطوتك للأفضل."
  },
  {
   "id": "cta",
   "start": 25.2,
   "end": 31.2,
   "text": "RESHAPE… غيّر أداءك، وارفع مستواك. سجّل الحين، وخلّ التحدّي يبدا!"
  }
 ],
