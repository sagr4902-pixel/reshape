{
 "voice_id": "96donzfHvBagGuYj2GLW",
 "lines": [
  {
   "id": "H1",
   "text": "اختبار سريع."
  },
  {
   "id": "H2",
   "text": "ثلاث حالات."
  },
  {
   "id": "H3",
   "text": "گُول لي… تمرين؟ ولّا تَگَدُّم؟"
  },
  {
   "id": "H4",
   "text": "ثلاثة من ثلاثة… وإنت البطل."
  },
  {
   "id": "R1a",
   "text": "الحالة الأولى."
  },
  {
   "id": "R1b",
   "text": "كل يوم مِيّة ضغطة… نفس العدد، نفس الطريگة، من سنة."
  },
  {
   "id": "R1c",
   "text": "تمرين؟ ولّا تَگَدُّم؟"
  },
  {
   "id": "R2a",
   "text": "الحالة الثانية."
  },
  {
   "id": "R2b",
   "text": "يشوف مَگاطع ويگلّد لحاله… بدون أحد يصحّح له."
  },
  {
   "id": "R2c",
   "text": "تمرين؟ ولّا تَگَدُّم؟"
  },
  {
   "id": "R3a",
   "text": "الحالة الثالثة."
  },
  {
   "id": "R3b",
   "text": "مدرّب يگيّمه، خطة واضحة، وكل أسبوع خطوة جديدة."
  },
  {
   "id": "R3c",
   "text": "تمرين؟ ولّا تَگَدُّم؟"
  },
  {
   "id": "A1",
   "text": "الجواب؟"
  },
  {
   "id": "A2",
   "text": "الأولى والثانية… تمرين."
  },
  {
   "id": "A3",
   "text": "والثالثة بس… تَگَدُّم."
  },
  {
   "id": "A4",
   "text": "كم جبت؟ اكتبها بالتعليگات."
  },
  {
   "id": "T1",
   "text": "لأن مو كل حركة… تعني تَگَدُّم."
  },
  {
   "id": "P1",
   "text": "في رِيشَيْب، التَّگَدُّم له خطة."
  },
  {
   "id": "P2",
   "text": "تدريب حضوري للكبار والصغار… خطوة بخطوة."
  },
  {
   "id": "P3",
   "text": "من أول حركة… لأگوى نسخة منك."
  },
  {
   "id": "C1",
   "text": "اكتب «ابدأ»… ونبدأ معك."
  }
 ]
}