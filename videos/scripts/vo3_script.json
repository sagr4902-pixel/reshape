  "lines": [
    {"id": "V1", "text": "هذا إنت؟"},
    {"id": "V2", "text": "طيب… شوف هذا."},
    {"id": "V3", "text": "أول عَگْلة!"},
    {"id": "V4", "text": "أول وَگْفة يد!"},
    {"id": "V5", "text": "أول ليفر!"},
    {"id": "V6", "text": "وللصغار؟ أول خطوة… بثِگة!"},
    {"id": "V7", "text": "في رِيشَيْب… تدريب حضوري،"},
    {"id": "V8", "text": "والتَّگَدُّم… ينشاف!"},
    {"id": "V9", "text": "رِيشَيْب. ابدأ اليوم!"}
  ]
}
