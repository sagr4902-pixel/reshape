  "lines": [
    {"id": "V1", "text": "هذا إنت؟"},
    {"id": "V2", "text": "طيب… شوف هذا."},
    {"id": "V3", "text": "أول عَقْلة!"},
    {"id": "V4", "text": "أول وَقْفة يد!"},
    {"id": "V5", "text": "أول ليفر!"},
    {"id": "V6", "text": "وللصغار؟ أول خطوة… بثِقة!"},
    {"id": "V7", "text": "في رِيشَيْب… تدريب حضوري،"},
    {"id": "V8", "text": "والتَّقَدُّم… ينشاف!"},
    {"id": "V9", "text": "رِيشَيْب. ابدأ اليوم!"}
  ]
}
